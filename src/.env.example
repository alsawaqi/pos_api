APP_NAME="MITHQAL POS API"
APP_ENV=local
# Leave BLANK then copy the SHARED key from pos_merchant/src/.env (the three
# apps share one Postgres with encrypted PII). Do NOT run key:generate — a
# divergent APP_KEY throws "The MAC is invalid." on every encrypted column.
APP_KEY=
# Keep FALSE everywhere except local dev — APP_DEBUG=true leaks stack traces,
# config values, env vars and SQL in error responses. Your local .env may set
# this true; deployed copies of this template must leave it false.
APP_DEBUG=false
APP_URL=http://localhost:8088

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Shared charity Postgres on charity_net (same DB as pos_admin + pos_merchant).
DB_CONNECTION=pgsql
DB_HOST=chariyt-db
DB_PORT=5432
DB_DATABASE=charity_db
DB_USERNAME=charity_user
DB_PASSWORD=super_secret_password
# This app's OWN migration ledger inside the shared DB (API-only tables).
DB_MIGRATIONS_TABLE=pos_api_migrations

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# Shared with pos_web to authenticate its X-Pos-Web-Client-IP assertion.
# Match the pos_api VPS .env value in pos_web VPS docker-compose.deploy.yml
# overrides for both pos_web and pos_web_optimize; blank keeps socket-IP behavior.
POS_API_CLIENT_IP_SECRET=

# LAUNCH-P1 1a: an activation code works only on the device it was made for
# (hardware serial + app type). off | report | enforce (default enforce).
# Use report only while devices still run APKs that do not send the serial.
POS_DEVICE_SERIAL_BINDING=enforce

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# REQUIRED before enabling the scheduled stranded-event recovery sweep.
# Existing installations must leave this blank for the first-stage deploy,
# capture the one-time production high-water id using
# docs/runbooks/stranded-sync-event-sweeper-cutover.md, then set that exact id.
# Use 0 only for a genuinely empty/fresh sync ledger. Missing/invalid values
# intentionally keep the sweep fail-closed.
SYNC_STRANDED_SWEEP_AFTER_ID=
# Keep false while capturing/verifying the floor and running the bounded
# manual canary. Enable only in the final runbook stage.
SYNC_STRANDED_SWEEP_ENABLED=false

# Where the APP (php-fpm) publishes to. Must be the UNIQUE compose alias —
# never the bare `reverb`, which is ambiguous on the shared charity_net.
# APP_ID/KEY/SECRET are blank here on purpose: set them in the live .env, and
# use byte-identical values in pos_admin and pos_merchant — same server, same HMAC.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=pos_api_reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# What the DEVICE dials — served in /device/config meta.websocket. Usually a
# DIFFERENT host from the publish target above. An empty PUBLIC_HOST means
# "use the API host you already talk to", which is right for the dev LAN only.
# PROD terminates wss on Nginx Proxy Manager and MUST set all three:
#   REVERB_PUBLIC_HOST=wss.mithqal.net
#   REVERB_PUBLIC_PORT=443
#   REVERB_PUBLIC_SCHEME=https
REVERB_PUBLIC_HOST=
REVERB_PUBLIC_PORT=8085
REVERB_PUBLIC_SCHEME=http

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=pos_api_redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Charity Laravel API base URL (POS round-up -> charity store_dhofar). Unset = skip.
CHARITY_API_URL=
CHARITY_API_TIMEOUT=8
# Shared with the charity API; signs the exact JSON body for each POS round-up.
POS_ROUNDUP_HMAC_SECRET=

# Sentry (Phase D1) — leave SENTRY_LARAVEL_DSN empty in local dev to disable.
# Device errors land with device_id / company_id / branch_id / request_id tags
# (AttachSentryDeviceContext) so alerts attribute to a terminal + tenant.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT="${APP_ENV}"
SENTRY_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_SEND_DEFAULT_PII=false
