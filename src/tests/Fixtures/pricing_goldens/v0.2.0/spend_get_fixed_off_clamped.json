        "lineAmountsBaisas": {}
      }
    ],
    "offerDiscountTotalBaisas": 10000,
    "orderDiscountBaisas": 0,
    "discountTotalBaisas": 10000,
    "subtotalBaisas": 0,
    "giftedTotalBaisas": 0,
